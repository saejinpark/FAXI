<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 안드로이드 11+에서 폰에 설치된 음성 엔진(TTS)을 찾기 위해 필요 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- 손님 한마디: 같은 Wi-Fi 안에서 폰 → 차 TCP 한 줄(인터넷 서버는 쓰지 않는다) -->
    <!-- 차량 값(읽기만). 주행거리·기어·브레이크: Pleos Vehicle SDK의 @RequiresPermission -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 속도: Android Car API PERF_VEHICLE_SPEED. dangerous 권한이라 실행 중에 묻는다 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17(API 37)부터 같은 Wi-Fi의 기기와 통신하려면 필요한 권한(근처 기기). 그 아래 버전에서는 무시된다 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".FaxiApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FAXI">
        <uses-library android:name="android.car" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FAXI"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              주행 중에도 보여 줄 수 있는 화면(DO, Distraction Optimized) 선언. Android Automotive 표준 방식.
              주행 중 화면은 정지 표시만 두고, 탑승·장부·기사 화면은 앱이 스스로 닫는다(AppShell).
              Pleos 문서에는 DO 선언 방법이 적혀 있지 않다. 플랫폼이 받아들이는지는 차량·심사에서 확인해야 한다.
            -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>

</manifest>