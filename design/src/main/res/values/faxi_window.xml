<?xml version="1.0" encoding="utf-8"?>
<!-- 앱이 뜨는 순간(Compose가 그리기 전) 창 바탕. ui/theme/Color.kt의 bg와 같은 값: 야간에 흰 화면이 번쩍이지 않게 -->
<resources>
    <color name="faxi_window_bg">#FFF2F4F8</color>
    <style name="Theme.Faxi.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/faxi_window_bg</item>
    </style>
</resources>
