<?xml version="1.0" encoding="utf-8"?>
<!--
  FAXI 앱 아이콘 앞면(택시 노랑).
  F 모양 택시 지붕 표시등(오른쪽이 열린 테두리) + 네 칸. 첫 칸은 비우고 나머지에 A·X·I.
  디자인은 100×100 격자로 그리고, 108dp 적응형 아이콘의 안전 영역(지름 66dp 원) 안에 들어오게 0.78배로 줄여 가운데에 놓는다.
  글자는 시스템 글꼴이 아니라 선으로 그린다(어느 기기에서나 같은 모양).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:translateX="11.68"
        android:translateY="14.03">
        <!-- F: 세로 기둥 + 위 가로 막대(오른쪽 끝이 열려 있다) -->
        <path
            android:pathData="M30,82 V24 H82"
            android:strokeColor="#FFC83D"
            android:strokeWidth="7"
            android:strokeLineJoin="round" />
        <!-- F 가운데 막대 = 표시등 아래 테두리 -->
        <path
            android:pathData="M30,55 H66"
            android:strokeColor="#FFC83D"
            android:strokeWidth="7" />
        <!-- 첫 칸: 비워 둔다("첫 글자가 왜 비었지?") -->
        <path
            android:pathData="M38,31 H43.5 A2,2 0 0 1 45.5,33 V46 A2,2 0 0 1 43.5,48 H38 A2,2 0 0 1 36,46 V33 A2,2 0 0 1 38,31 Z"
            android:strokeColor="#FFC83D"
            android:strokeAlpha="0.45"
            android:strokeWidth="1.5" />
        <!-- A -->
        <path
            android:pathData="M48.6,44.5 L52.25,34.3 L55.9,44.5 M49.9,41.2 H54.6"
            android:strokeColor="#FFC83D"
            android:strokeWidth="2.4" />
        <!-- X -->
        <path
            android:pathData="M60.2,34.3 L67.3,44.5 M67.3,34.3 L60.2,44.5"
            android:strokeColor="#FFC83D"
            android:strokeWidth="2.4" />
        <!-- I -->
        <path
            android:pathData="M75.25,34.3 V44.5"
            android:strokeColor="#FFC83D"
            android:strokeWidth="2.6" />
    </group>
</vector>
