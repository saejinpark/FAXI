<?xml version="1.0" encoding="utf-8"?>
<!--
  FAXI 앱 아이콘(B안 "집 모양 표시등"). 산호 바탕 위에 남색 집 모양 택시 표시등, 그 안에 산호 F, 아래에 차 지붕 곡선.
  - 집 = 가족(Family), 지붕 위 표시등 = 택시(Taxi). 그림 하나에 FAXI 두 낱말이 들어 있다.
  - 표시등 안 F가 앱 이름 첫 글자. 글자는 시스템 글꼴이 아니라 둥근 끝 선.
  - 차 지붕 곡선은 양 끝이 마스크 밖으로 나가 원·둥근 네모 어디서든 "지붕 위에 올라앉은" 모양이 된다.
  108dp 격자 그대로 그린다. 집과 F는 보이는 영역(가운데 72dp, 18~90) 안쪽 30~78에 둔다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 집 모양 표시등 -->
    <path
        android:fillColor="#1F2B42"
        android:pathData="M51,30 Q54,28 57,30 L75,43 Q78,45 78,49 V64 Q78,68 74,68 H34 Q30,68 30,64 V49 Q30,45 33,43 Z" />
    <!-- F -->
    <path
        android:pathData="M47,45 V61 M47,45 H61 M47,53 H58"
        android:strokeColor="#F2845F"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 차 지붕 -->
    <path
        android:pathData="M20,92 C30,73 78,73 88,92"
        android:strokeColor="#1F2B42"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
</vector>
